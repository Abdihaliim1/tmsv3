rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Tenant document uploads (Rate Con, BOL, POD, receipts, etc.)
    // Auth-only: Firestore membership cross-gets were denying legitimate ATS users
    // (storage/unauthorized) even when the same user could use the rest of the app.
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.size < 25 * 1024 * 1024;
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
